# Optional deployment overrides. Application settings belong in config.toml.
# Copy to .env for automatic loading, or use Docker's --env-file.
# The image already sets these two values:
# CHUNKIFY_DATA_DIR=/data
# CHUNKIFY_BIND=0.0.0.0:4174

# Optional replacement for the bundled City MMDB, available inside the container:
# CHUNKIFY_GEOIP_DATABASE=/geolocation/dbip-city-lite.mmdb

# Select S3 storage here or in [storage] in config.toml.
# CHUNKIFY_STORAGE_BACKEND=s3
# CHUNKIFY_S3_URL=s3://my-bucket/analytics/
# CHUNKIFY_S3_REGION=us-east-1

# AWS credentials come from the ECS task role or standard AWS_* process variables.
# Optional S3-compatible provider overrides, for example Cloudflare R2:
# CHUNKIFY_S3_ENDPOINT=ACCOUNT_ID.r2.cloudflarestorage.com
# For R2, use CHUNKIFY_S3_REGION=auto instead of an AWS region.
# CHUNKIFY_S3_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
# CHUNKIFY_S3_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
# CHUNKIFY_S3_SESSION_TOKEN=...
# CHUNKIFY_S3_URL_STYLE=path
# CHUNKIFY_S3_USE_SSL=true

# Or select ClickHouse storage, shared by several analytics servers.
# CHUNKIFY_STORAGE_BACKEND=clickhouse
# CHUNKIFY_CLICKHOUSE_URL=http://clickhouse:8123
# CHUNKIFY_CLICKHOUSE_DATABASE=chunkify_analytics
# CHUNKIFY_CLICKHOUSE_USER=chunkify
# CHUNKIFY_CLICKHOUSE_PASSWORD=YOUR_CLICKHOUSE_PASSWORD
# CHUNKIFY_CLICKHOUSE_NODE_ID=1

# Optional project provisioning and key recovery APIs. Use a separate random secret.
# Keep this key in your trusted backend; it can rotate keys for every project.
# CHUNKIFY_ADMIN_KEY=YOUR_PRIVATE_ADMIN_KEY

# Optional stdio MCP adapter. Keep secret keys private.
# The URL is the analytics HTTP API base URL.
# CHUNKIFY_MCP_URL=http://127.0.0.1:4174
# CHUNKIFY_MCP_SECRET_KEY=YOUR_PRIVATE_SECRET_KEY
