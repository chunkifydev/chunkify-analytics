# Copy to .env for automatic loading by the executable.
# With Docker, pass it using docker run --env-file .env.
# Replace this with the exact website origin that sends analytics.
COLLECTOR_ALLOWED_ORIGINS=https://player.example.com

# Installation policy: 30 days, IP collection enabled, no trusted proxy by default.
COLLECTOR_RETENTION_SECONDS=2592000
COLLECTOR_STORE_IP=true
COLLECTOR_TRUSTED_PROXIES=

# Initial admission limit, not a capacity promise. Project limits also apply.
COLLECTOR_INGEST_PER_SECOND=100

# Recommended starting mode. Optional tuning is documented in configuration.md.
COLLECTOR_DUCKDB_THREADS=1
COLLECTOR_INSERT_MODE=bulk
COLLECTOR_EXPERIMENTAL_DURABLE_QUEUE=false
COLLECTOR_EXPERIMENTAL_REPLAY_PIPELINE=false
COLLECTOR_EXPERIMENTAL_READ_WORKER=false

# Other batch/queue/checkpoint settings keep their built-in defaults.
# The image provides /data and 0.0.0.0:4174; mount a persistent volume at /data.
# Generate credentials with the offline CLI. Do not put read tokens in browser code.
