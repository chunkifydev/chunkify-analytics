# Optional deployment overrides. Application settings belong in config.toml.
# Copy to .env for automatic loading, or use Docker's --env-file.
# The image already sets these two values:
# COLLECTOR_DATA_DIR=/data
# COLLECTOR_BIND=0.0.0.0:4174

# Select backend = "s3" in [storage] in config.toml first.
# COLLECTOR_S3_URL=s3://my-bucket/analytics/
# COLLECTOR_S3_ENDPOINT=ACCOUNT_ID.r2.cloudflarestorage.com
# COLLECTOR_S3_REGION=auto
# COLLECTOR_S3_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
# COLLECTOR_S3_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
# COLLECTOR_S3_SESSION_TOKEN=...
# COLLECTOR_S3_URL_STYLE=path
# COLLECTOR_S3_USE_SSL=true

# Optional project provisioning API. Use a separate random secret.
# COLLECTOR_ADMIN_KEY=YOUR_PRIVATE_ADMIN_KEY

# Optional stdio MCP adapter. Keep secret keys private.
# CHUNKIFY_MCP_COLLECTOR_URL=http://127.0.0.1:4174
# CHUNKIFY_MCP_SECRET_KEY=YOUR_PRIVATE_SECRET_KEY
