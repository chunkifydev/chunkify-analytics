# Copy to config.toml. Omitted settings keep their built-in defaults.
# Precedence: CLI flags > process environment > .env > TOML > defaults.
# Relative TOML data paths are resolved beside this file.
data_dir = "./data"
profile = false

[logging]
# One summary per saved batch. Use warn for failures only, debug for batch starts.
level = "info"

[storage]
# Local storage is the default. S3-compatible storage also uses this section.
backend = "local"
# Optional database file; defaults to analytics.duckdb inside data_dir.
# path = "./data/analytics.duckdb"
# For S3 or R2, replace backend with "s3" and set these in the same section:
# url = "s3://my-bucket/analytics/"
# endpoint = "ACCOUNT_ID.r2.cloudflarestorage.com"
# region = "auto"
# access_key_id = "YOUR_ACCESS_KEY_ID"
# secret_access_key = "YOUR_SECRET_ACCESS_KEY"
# session_token = "..." # Optional for temporary credentials.
# url_style = "path"   # Or "vhost".
# use_ssl = true       # Set false only for an HTTP endpoint.
# Omit explicit credentials on AWS to use the task role.
# Optional S3 buffering: return HTTP 201 immediately and upload within 60 seconds,
# or sooner when a batch fills. Buffered events can be lost on a crash.
# flush_interval_seconds = 60
# Omit or set 0 to wait for each upload before acknowledging events.
# See docs/storage.md for setup, expiration and single-writer operation.

[server]
# External base URL for CSV download links behind an ingress or URL prefix:
# public_url = "https://analytics.example.com/"
bind = "127.0.0.1:4174"
allowed_origins = ["http://localhost:3000"]
trusted_proxies = []
# Continent, country and city lookup is always on. Request IPs are never stored.
# The image/release includes a City MMDB. Override only to use your own file:
# geoip_database = "./dbip-city-lite.mmdb"
max_body_bytes = 65536
ingest_per_second = 100

[rate_limits]
# Per-project request rates, shared across HTTP, MCP and all project keys.
# Rates refill continuously. Reads allow the configured burst; export burst
# capacities equal their per-minute rates. All values must be positive.
read_per_minute = 120
read_burst = 20
read_concurrent_per_project = 16
read_concurrent = 32
export_links_per_minute = 10
export_downloads_per_minute = 2
export_concurrent_per_project = 1
export_concurrent = 4

[retention]
seconds = 2592000
interval_seconds = 3600

[batch]
# Optional limits for buffered S3: up to 10 MiB or 10,000 events per upload.
# Without overrides, local/unbuffered storage uses 1 MiB and 100 events.
# max_events = 10000
# max_bytes = 10485760
delay_ms = 10
# Buffered S3 defaults to 32 MiB and 4096 outstanding requests; otherwise
# defaults are 16 MiB and 256 requests. Increase with larger batch limits.
# queue_max_bytes = 33554432
# queue_max_requests = 4096
insert_mode = "bulk"

[duckdb]
# Recommended starting value; omit threads to let DuckDB choose automatically.
threads = 1
checkpoint_threshold_mib = 16

[experimental]
read_worker = false

[mcp]
enabled = true
# Add the public HTTP hostname when exposing /mcp through an ingress.
allowed_hosts = ["localhost", "127.0.0.1", "[::1]"]
# Used only by the local stdio companion. Keep real tokens in a private file
# or CHUNKIFY_MCP_SECRET_KEY in the environment.
# The URL is the analytics HTTP API base URL.
url = "http://127.0.0.1:4174"
# secret_key = "..."

# S3 report freshness. Local storage defaults to 0; raw events and exports bypass it.
[cache]
report_ttl_seconds = 60
