# Copy to config.toml. Omitted settings keep their built-in defaults.
# Precedence: CLI flags > process environment > .env > TOML > defaults.
# Relative TOML paths are resolved beside this file.

[logging]
# One summary per saved batch. Use warn for failures only, debug for batch starts.
level = "info"

[clickhouse]
# Events, projects and key hashes live in this ClickHouse database. Any number of
# analytics servers can share it. Run `init` once per database.
url = "http://127.0.0.1:8123"
database = "chunkify_analytics"
# user = "chunkify"
# password = "..."                   # Prefer CHUNKIFY_CLICKHOUSE_PASSWORD.
# Let ClickHouse combine inserts from all servers; requests still wait for storage.
async_insert = true
# Seconds between checks for project and key changes made elsewhere.
registry_refresh_seconds = 5
# Repeated event IDs within this window return duplicate: true. 0 stores every delivery.
deduplication_window_seconds = 604800
# Optional 0..63, distinct for each server sharing the database.
# node_id = 1

[server]
# External base URL for CSV download links behind an ingress or URL prefix:
# public_url = "https://analytics.example.com/"
bind = "127.0.0.1:4174"
allowed_origins = ["http://localhost:3000"]
trusted_proxies = []
# Continent, country and city lookup is always on. Request IPs are never stored.
# The image/release includes a City MMDB. Override only to use your own file:
# geoip_database = "./dbip-city-lite.mmdb"
max_body_bytes = 65536
ingest_per_second = 100

[rate_limits]
# Per-project request rates, shared across HTTP, MCP and all project keys.
# Rates refill continuously. Reads allow the configured burst; export burst
# capacities equal their per-minute rates. All values must be positive.
read_per_minute = 120
read_burst = 20
read_concurrent_per_project = 16
read_concurrent = 32
export_links_per_minute = 10
export_downloads_per_minute = 2
export_concurrent_per_project = 1
export_concurrent = 4

[retention]
seconds = 2592000
interval_seconds = 3600

[batch]
# Each server batches requests; requests queued while one batch is saved form the
# next. Limits apply per batch and to memory held for waiting requests.
# max_events = 10000
# max_bytes = 10485760
delay_ms = 10
# queue_max_bytes = 33554432
# queue_max_requests = 4096

[mcp]
enabled = true
# Add the public HTTP hostname when exposing /mcp through an ingress.
allowed_hosts = ["localhost", "127.0.0.1", "[::1]"]
# Used only by the local stdio companion. Keep real tokens in a private file
# or CHUNKIFY_MCP_SECRET_KEY in the environment.
# The URL is the analytics HTTP API base URL.
url = "http://127.0.0.1:4174"
# secret_key = "..."

# Optional per-server report cache, in seconds. Raw events and exports bypass it.
[cache]
report_ttl_seconds = 0
