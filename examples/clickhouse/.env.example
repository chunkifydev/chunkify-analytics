# Copy to .env next to compose.yaml.
# Password for the ClickHouse user that the analytics servers use.
CLICKHOUSE_PASSWORD=change-me-to-a-long-random-value

# Optional: enable project creation and key recovery through the API.
# CHUNKIFY_ADMIN_KEY=YOUR_PRIVATE_ADMIN_KEY

# Optional: use a locally built image instead of the published one.
# CHUNKIFY_IMAGE=chunkify-analytics:local
